{
  "name": "focalboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "test": "NODE_ENV=test bun test",
    "test:integration": "NODE_ENV=test bun test tests/integration/",
    "test:e2e": "NODE_ENV=test playwright test",
    "test:e2e:ui": "NODE_ENV=test playwright test --ui",
    "test:e2e:debug": "NODE_ENV=test playwright test --debug",
    "test:e2e:headed": "NODE_ENV=test playwright test --headed",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun src/backend/db/migrate.ts",
    "db:seed": "bun src/backend/db/seed.ts",
    "db:seed:force": "bun src/backend/db/seed.ts --force"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.18",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-router": "^1.158.4",
    "better-auth": "^1.4.18",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.8",
    "lucide-react": "^0.563.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.11",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.18",
    "@playwright/test": "^1.58.2",
    "@tanstack/router-devtools": "^1.158.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  }
}